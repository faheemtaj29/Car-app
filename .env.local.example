# Copy to .env.local and fill in.
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/sabaq
# Long random string used to sign login cookies (staff and marketplace members).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public address of the website (used in the sitemap and share links), e.g. https://tajmotors.pk
SITE_URL=http://localhost:3000

# Hours a new member account must wait before posting reviews (anti-spam). Default 24.
# REVIEW_MIN_ACCOUNT_HOURS=24

# Key for encrypting CNIC numbers (defaults to JWT_SECRET). Set once; changing it makes stored CNICs unreadable.
# KYC_SECRET=

# NADRA identity verification — OFF until you have a NADRA (Verisys) agreement.
# off (default) | verisys (real) | mock (development/tests only; ignored in production)
# See src/backend/lib/nadra.ts for the switch-on checklist.
NADRA_PROVIDER=off
# NADRA_API_URL=
# NADRA_CLIENT_ID=
# NADRA_CLIENT_SECRET=
# NADRA_ORG_CODE=
# Set to 1 to mark sellers verified automatically on a full NADRA match.
# NADRA_AUTO_VERIFY=0

# Photos: "local" (default, saved on this machine; set UPLOAD_DIR for a persistent folder) or "s3"
# (any S3-compatible bucket: Cloudflare R2, AWS S3, MinIO...). See DEPLOY.md.
# STORAGE_DRIVER=local
# UPLOAD_DIR=
