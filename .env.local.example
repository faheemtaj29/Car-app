# Copy to .env.local and fill in.
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/sabaq
# Long random string used to sign login cookies (staff and marketplace members).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public address of the website (used in the sitemap and share links), e.g. https://tajmotors.pk
SITE_URL=http://localhost:3000
