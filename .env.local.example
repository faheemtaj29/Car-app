# Copy to .env.local and fill in.
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/sabaq
# Long random string used to sign login cookies (staff and marketplace members).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public address of the website (used in the sitemap and share links), e.g. https://tajmotors.pk
SITE_URL=http://localhost:3000

# Hours a new member account must wait before posting reviews (anti-spam). Default 24.
# REVIEW_MIN_ACCOUNT_HOURS=24

# Key for encrypting CNIC numbers (defaults to JWT_SECRET). Set once; changing it makes stored CNICs unreadable.
# KYC_SECRET=
