# Copy to .env (never commit it) and fill in every line marked REQUIRED.

# REQUIRED. Your website address, without a trailing slash. Used in certificates, QR codes, sitemap.
SITE_URL=https://cars.example.pk
# REQUIRED for docker compose: the domain Caddy gets an HTTPS certificate for (same host as above).
DOMAIN=cars.example.pk

# REQUIRED. Long random text: run  openssl rand -hex 32
JWT_SECRET=
# Optional: separate key for encrypting CNIC numbers (defaults to JWT_SECRET). Set once and never change it.
KYC_SECRET=

# Photos. "local" keeps them in the uploads volume. For a cloud bucket (AWS S3, Cloudflare R2, MinIO…):
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.pk
# S3_FORCE_PATH_STYLE=0

# NADRA verification stays off until you have an agreement (see README).
NADRA_PROVIDER=off
